{
  "name": "evorail",
  "private": true,
  "version": "0.1.0",
  "description": "EvoRail engineering information control system",
  "workspaces": [
    "mcp"
  ],
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview:v2": "vite preview --host 127.0.0.1",
    "mcp:build": "npm --workspace mcp run build",
    "mcp:test": "npm --workspace mcp test",
    "mcp:stdio": "npm --workspace mcp run start:stdio",
    "mcp:http": "npm --workspace mcp run start:http",
    "preview": "node scripts/preview-server.mjs prototypes"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "@astryxdesign/core": "^0.6.3",
    "@heroicons/react": "^2.2.0",
    "@stylexjs/stylex": "^0.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
}
