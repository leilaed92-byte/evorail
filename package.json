{
  "name": "evorail",
  "private": true,
  "version": "0.1.0",
  "description": "EvoRail engineering information control system",
  "workspaces": [
    "mcp"
  ],
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview:v2": "vite preview --host 127.0.0.1",
    "mcp:build": "npm --workspace mcp run build",
    "mcp:test": "npm --workspace mcp test",
    "mcp:stdio": "npm --workspace mcp run start:stdio",
    "mcp:http": "npm --workspace mcp run start:http",
    "preview": "node scripts/preview-server.mjs prototypes",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "TMPDIR=/var/tmp playwright test",
    "test:backend": "cd backend && php artisan test --compact",
    "quality": "npm run test:backend && npm test && npm run build && npm run mcp:build && npm run mcp:test && git diff --check",
    "test:frontend": "vitest run"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "@astryxdesign/core": "^0.6.3",
    "@heroicons/react": "^2.2.0",
    "@stylexjs/stylex": "^0.19.0",
    "@tanstack/react-table": "^9.2.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "lucide-react": "^1.49.0",
    "pdfjs-dist": "6.3.289",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-pdf": "^11.0.0",
    "sonner": "^2.0.8",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "jsdom": "^30.1.1",
    "vitest": "^5.0.3"
  }
}
